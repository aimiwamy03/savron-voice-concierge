# Copy to .env. Never commit real values.
DEEPGRAM_API_KEY=
# SHOP=savron                 # file name in shops/, without .json
# PORT=3000
# HOST=127.0.0.1
# SHOP_INFO_TTL_MIN=5         # re-pull sources at call start when older than this
# LLM_MODEL=gpt-4.1-mini
# VOICE_EN=aura-2-helena-en
# VOICE_ES=aura-2-selena-es

# Texts. Without all three Twilio values, texts are logged to the page and not sent.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...
# SHOP_NOTIFY_PHONE=+1...     # who gets handoffs and booking requests
# BARBER_PHONES={"Barber Name":"+1..."}   # for barbers on an outside calendar. Never spoken to callers.

# Real phone calls through Twilio. The public https URL that reaches this server.
# PUBLIC_URL=https://example.ngrok.app
